#!/bin/sh
. /common.sh

echo test > /m4-enter66-caught
echo test > /m4-enter66-uncaught
cat /m4-enter66.lua > /sys/kernel/security/lua/register || fail 'register m4_enter66'
grep -q '^m4_enter66 ' /sys/kernel/security/lua/modules || fail 'm4_enter66 not listed'
log 'M4_ENTER66: BEGIN caught'
if cat /m4-enter66-caught >/dev/null; then fail 'enter66 caught unexpectedly allowed'; fi
log 'M4_ENTER66: PASS caught'
log 'M4_ENTER66: BEGIN uncaught'
cat /m4-enter66-uncaught >/dev/null || fail 'enter66 uncaught behavior changed'
log 'M4_ENTER66: ALLOW uncaught'
unload_policy m4_enter66 /m4-enter66-caught
log 'M4_ENTER66: PASS'
sync
reboot -f
sleep 2
exec sh
