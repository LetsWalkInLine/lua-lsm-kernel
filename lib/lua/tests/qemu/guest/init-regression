#!/bin/sh
. /common.sh
for mode in find match gmatch gsub capture32 find-error match-error gmatch-error gsub-error uncaught; do
  echo test > /m2-depth-$mode || fail "create $mode"
done
cat /m2-depth.lua > /sys/kernel/security/lua/register || fail 'register m2_depth'
grep -q '^m2_depth ' /sys/kernel/security/lua/modules || fail 'm2_depth not listed'
for mode in find match gmatch gsub capture32 find-error match-error gmatch-error gsub-error; do
  log "M2_DEPTH: BEGIN $mode"
  if cat /m2-depth-$mode >/dev/null; then
    fail "M2_DEPTH $mode unexpectedly allowed"
  fi
  log "M2_DEPTH: PASS $mode"
done
log 'M2_DEPTH: BEGIN uncaught'
cat /m2-depth-uncaught >/dev/null || fail 'uncaught error behavior changed'
log 'M2_DEPTH: observed current uncaught-error allow behavior'
unload_policy m2_depth /m2-depth-gsub
log 'M2_DEPTH: PASS'

for mode in plain find match gmatch gsub output uncaught; do
  echo test > /m4-work-$mode || fail "create m4 $mode"
done
cat /m4-work.lua > /sys/kernel/security/lua/register || fail 'register m4_work'
grep -q '^m4_work ' /sys/kernel/security/lua/modules || fail 'm4_work not listed'
for mode in plain find match gmatch gsub output; do
  if cat /m4-work-$mode >/dev/null; then
    fail "M4_WORK $mode unexpectedly allowed"
  fi
  log "M4_WORK: PASS $mode"
done
cat /m4-work-uncaught >/dev/null || fail 'work uncaught-error behavior changed'
log 'M4_WORK: observed current uncaught-error allow behavior'
unload_policy m4_work /m4-work-gsub
log 'M4_WORK: PASS'

for mode in find match gmatch gsub find-uncaught match-uncaught gmatch-uncaught gsub-uncaught plain-compare capture-compare capture-output whole-output value-output tail-output; do
 echo test > /m4-deep-$mode || fail "create deep $mode"
done
cat /m4-deep.lua > /sys/kernel/security/lua/register || fail 'register m4_deep'
grep -q '^m4_deep ' /sys/kernel/security/lua/modules || fail 'm4_deep not listed'
for mode in find match gmatch gsub plain-compare capture-compare capture-output whole-output value-output tail-output; do
 log "M4_DEEP: BEGIN $mode"
 if cat /m4-deep-$mode >/dev/null; then fail "M4_DEEP $mode unexpectedly allowed"; fi
 log "M4_DEEP: PASS $mode"
done
for mode in find match gmatch gsub; do
 log "M4_DEEP: BEGIN $mode-uncaught"
 cat /m4-deep-$mode-uncaught >/dev/null || fail "deep $mode uncaught behavior changed"
 log "M4_DEEP: ALLOW $mode-uncaught"
done
unload_policy m4_deep /m4-deep-gsub
log 'M4_DEEP: PASS'

sync
reboot -f
sleep 2
exec sh
