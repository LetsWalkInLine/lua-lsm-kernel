#!/bin/sh

export PATH=/bin

fail()
{
	echo "LUA_LSM_SMOKE: FAIL: $*"
	sync
	reboot -f
	sleep 2
	exec sh
}

echo 'LUA_LSM_SMOKE: booted initramfs'
uname -a

mount -t devtmpfs devtmpfs /dev || fail 'cannot mount devtmpfs'
mount -t proc proc /proc || fail 'cannot mount procfs'
mount -t sysfs sysfs /sys || fail 'cannot mount sysfs'
mkdir -p /sys/kernel/security
mount -t securityfs securityfs /sys/kernel/security || fail 'cannot mount securityfs'

active_lsms=$(cat /sys/kernel/security/lsm) || fail 'cannot read active LSMs'
echo "LUA_LSM_SMOKE: active LSMs: $active_lsms"
case ",$active_lsms," in
	*,lua,*) ;;
	*) fail 'lua is not in the active LSM list' ;;
esac

test -r /sys/kernel/security/lua/version || fail 'Lua-LSM securityfs files are missing'
echo "LUA_LSM_SMOKE: version $(cat /sys/kernel/security/lua/version)"

echo 'secret' > /lua-lsm-denied || fail 'cannot create policy target'
cat /lua-lsm-smoke.lua > /sys/kernel/security/lua/register || fail 'cannot register smoke policy'
grep -q '^smoke ' /sys/kernel/security/lua/modules || fail 'registered module not listed'
test -r /sys/kernel/security/lua/stats || fail 'stats file is missing'
test -r /sys/kernel/security/lua/lsm_funcs || fail 'hook stats file is missing'

if cat /lua-lsm-denied >/dev/null 2>&1; then
	fail 'file_open policy did not deny the protected path'
fi
echo 'LUA_LSM_SMOKE: policy denial observed'

unregister_attempt=1
while ! echo smoke > /sys/kernel/security/lua/unregister; do
	if [ "$unregister_attempt" -ge 10 ]; then
		fail 'cannot unregister smoke policy after 10 attempts'
	fi
	echo "LUA_LSM_SMOKE: unregister busy, retrying ($unregister_attempt/10)"
	unregister_attempt=$((unregister_attempt + 1))
	sleep 1
done
if ! cat /lua-lsm-denied >/dev/null; then
	fail 'access did not recover after policy unload'
fi

echo 'LUA_LSM_SMOKE: unload recovery observed'
echo 'LUA_LSM_SMOKE: PASS'

for mode in find match gmatch gsub capture32 find-error match-error gmatch-error gsub-error uncaught; do
  echo test > /m2-depth-$mode || fail "create $mode"
done
cat /m2-depth.lua > /sys/kernel/security/lua/register || fail 'register m2_depth'
grep -q '^m2_depth ' /sys/kernel/security/lua/modules || fail 'm2_depth not listed'
for mode in find match gmatch gsub capture32 find-error match-error gmatch-error gsub-error; do
  echo "M2_DEPTH: BEGIN $mode"
  if cat /m2-depth-$mode >/dev/null; then
    fail "M2_DEPTH $mode unexpectedly allowed"
  fi
  echo "M2_DEPTH: PASS $mode"
done
echo 'M2_DEPTH: BEGIN uncaught'
cat /m2-depth-uncaught >/dev/null || fail 'uncaught error behavior changed'
echo 'M2_DEPTH: observed current uncaught-error allow behavior'
attempt=1
while ! echo m2_depth > /sys/kernel/security/lua/unregister; do
  test "$attempt" -lt 10 || fail 'unregister m2_depth'
  attempt=$((attempt + 1))
  sleep 1
done
cat /m2-depth-gsub >/dev/null || fail 'm2_depth unload recovery'
echo 'M2_DEPTH: PASS'

for mode in plain find match gmatch gsub output uncaught; do
  echo test > /m4-work-$mode || fail "create m4 $mode"
done
cat /m4-work.lua > /sys/kernel/security/lua/register || fail 'register m4_work'
grep -q '^m4_work ' /sys/kernel/security/lua/modules || fail 'm4_work not listed'
for mode in plain find match gmatch gsub output; do
  if cat /m4-work-$mode >/dev/null; then
    fail "M4_WORK $mode unexpectedly allowed"
  fi
  echo "M4_WORK: PASS $mode"
done
cat /m4-work-uncaught >/dev/null || fail 'work uncaught-error behavior changed'
echo 'M4_WORK: observed current uncaught-error allow behavior'
attempt=1
while ! echo m4_work > /sys/kernel/security/lua/unregister; do
  test "$attempt" -lt 10 || fail 'unregister m4_work'
  attempt=$((attempt + 1))
  sleep 1
done
cat /m4-work-gsub >/dev/null || fail 'm4_work unload recovery'
echo 'M4_WORK: PASS'

for mode in find match gmatch gsub find-uncaught match-uncaught gmatch-uncaught gsub-uncaught plain-compare capture-compare capture-output whole-output value-output tail-output; do
 echo test > /m4-deep-$mode || fail "create deep $mode"
done
cat /m4-deep.lua > /sys/kernel/security/lua/register || fail 'register m4_deep'
grep -q '^m4_deep ' /sys/kernel/security/lua/modules || fail 'm4_deep not listed'
for mode in find match gmatch gsub plain-compare capture-compare capture-output whole-output value-output tail-output; do
 echo "M4_DEEP: BEGIN $mode"
 if cat /m4-deep-$mode >/dev/null; then fail "M4_DEEP $mode unexpectedly allowed"; fi
 echo "M4_DEEP: PASS $mode"
done
for mode in find match gmatch gsub; do
 echo "M4_DEEP: BEGIN $mode-uncaught"
 cat /m4-deep-$mode-uncaught >/dev/null || fail "deep $mode uncaught behavior changed"
 echo "M4_DEEP: ALLOW $mode-uncaught"
done
attempt=1
while ! echo m4_deep > /sys/kernel/security/lua/unregister; do
 test "$attempt" -lt 10 || fail 'unregister m4_deep'
 attempt=$((attempt+1)); sleep 1
done
cat /m4-deep-gsub >/dev/null || fail 'm4_deep unload recovery'
echo 'M4_DEEP: PASS'

sync
reboot -f
sleep 2
exec sh
