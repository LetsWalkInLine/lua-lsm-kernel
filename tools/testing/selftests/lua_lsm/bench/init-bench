#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Benchmark guest init: one syscall scenario per boot.  The scenario
# and sample counts come from the kernel command line, so one image
# serves pilot and formal runs.
export PATH=/bin

# Plain tty output: init markers must not race the program output, and
# kernel printk is silenced below because console writes can clobber
# bytes mid-line in the tty stream.
log()
{
	printf '%s\n' "$*"
}

fail()
{
	log "LUA_BENCH: FAIL: $*"
	sync
	reboot -f
	sleep 2
	exec sh
}

log 'LUA_BENCH: boot'
uname -a
mount -t devtmpfs devtmpfs /dev || fail 'cannot mount devtmpfs'
mount -t proc proc /proc || fail 'cannot mount procfs'
mount -t sysfs sysfs /sys || fail 'cannot mount sysfs'
mkdir -p /sys/kernel/security
mount -t securityfs securityfs /sys/kernel/security || fail 'cannot mount securityfs'

ACTIVE=$(cat /sys/kernel/security/lsm) || fail 'cannot read active LSMs'
log "LUA_BENCH: lsm: $ACTIVE"

SCN=$(sed -n 's/.*lua_bench_scn=\([^ ]*\).*/\1/p' /proc/cmdline)
COUNTS=$(sed -n 's/.*lua_bench_counts=\([^ ]*\).*/\1/p' /proc/cmdline)
test -n "$SCN" || fail 'no lua_bench_scn on cmdline'
test -n "$COUNTS" || fail 'no lua_bench_counts on cmdline'

case ",$(cat /sys/kernel/security/lsm)," in
*,lua,*) ;;
*) case "$SCN" in nolua) ;; *) fail "lua not active for $SCN" ;; esac ;;
esac
case "$SCN" in
nolua) case ",$(cat /sys/kernel/security/lsm)," in *,lua,*) fail 'lua active for nolua' ;; esac ;;
esac

# Keep the serial console free of kernel printk while raw samples are
# emitted: console writes and tty writes share the UART and a printk
# can clobber bytes mid-line.  Diagnostics are checked from the dmesg
# buffer at the end instead.
dmesg -n 1 || fail 'cannot lower console loglevel'

echo target > /bench-target || fail 'cannot create bench target'
# Resolve the sample counts before any policy can interfere.
COUNTS_ARGS=$(echo "$COUNTS" | tr ',' ' ') || fail 'cannot split counts'
case "$SCN" in
nopolicy|nolua) ;;
*) cat /bench-policy.lua > /sys/kernel/security/lua/register || fail "register $SCN" ;;
esac

EXPECT=ok
case "$SCN" in
timeout) EXPECT=eio ;;
esac
log "LUA_BENCH: scenario $SCN expect $EXPECT"
set -- $COUNTS_ARGS
# Program output goes to a file and is emitted after exit: the tty layer
# flushes userspace writes asynchronously and printk would otherwise
# wedge itself into the middle of raw sample lines.  On failure the file
# is emitted too, so the host sees the failing sample line and can
# classify the failure instead of retrying a real measurement event.
if ! /bench-syscall "$SCN" /bench-target "$EXPECT" "$1" "$2" "$3" "$4" "$5" > /bench-out.txt; then
	cat /bench-out.txt
	fail 'bench-syscall failed'
fi
cat /bench-out.txt
if dmesg | grep -qE 'BUG:|WARNING:|Oops:|Kernel panic|KASAN:|UBSAN:'; then
	dmesg | tail -80
	fail 'kernel diagnostic appeared during the benchmark'
fi
log 'LUA_BENCH: PASS'
sync
reboot -f
sleep 2
exec sh
